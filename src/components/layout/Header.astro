---
interface Props {
  lang?: 'ko' | 'en';
}

const { lang = 'ko' } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/en/' || currentPath === '/en';
const isAbout = currentPath.includes('/about');

function localePath(path: string): string {
  if (lang === 'en') return `/en${path}`;
  return path;
}

function toggleLangPath(): string {
  if (lang === 'ko') {
    return currentPath === '/' ? '/en/' : `/en${currentPath}`;
  }
  return currentPath.replace(/^\/en/, '') || '/';
}
---

<header class="header">
  <div class="header__inner container">
    <a href={localePath('/')} class="header__logo">
      studionin
    </a>

    <nav class="header__nav">
      <a
        href={localePath('/')}
        class:list={['header__link', { 'is-active': isHome }]}
      >
        Work
      </a>
      <a
        href={localePath('/about/')}
        class:list={['header__link', { 'is-active': isAbout }]}
      >
        About
      </a>
      <a href={toggleLangPath()} class="header__link header__lang">
        {lang === 'ko' ? 'EN' : 'KO'}
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .header__logo {
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-black);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__link {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__link:hover {
    color: var(--color-black);
  }

  .header__link.is-active {
    color: var(--color-black);
    font-weight: 600;
  }

  .header__lang {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-gray-300);
    border-radius: 2px;
  }

  .header__lang:hover {
    border-color: var(--color-black);
  }
</style>
