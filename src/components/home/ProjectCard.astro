---
interface Props {
  title: string;
  slug: string;
  organization: string;
  year: number;
  type: string[];
  sector: string;
  thumbnailSrc?: string;
  lang?: 'ko' | 'en';
}

const {
  title,
  slug,
  organization,
  year,
  type,
  sector,
  thumbnailSrc,
  lang = 'ko',
} = Astro.props;

const href = lang === 'en' ? `/en/project/${slug}/` : `/project/${slug}/`;
---

<article
  class="project-card fade-in"
  data-type={type.join(' ')}
  data-sector={sector}
  data-year={year}
>
  <a href={href} class="project-card__link">
    <div class="project-card__image-wrap">
      {
        thumbnailSrc ? (
          <img
            src={thumbnailSrc}
            alt={title}
            class="project-card__image"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="project-card__placeholder" />
        )
      }
    </div>
    <div class="project-card__info">
      <h3 class="project-card__title">{title}</h3>
      <div class="project-card__meta">
        <span class="project-card__org">{organization}</span>
        <span class="project-card__year">{year}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card__link {
    display: block;
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-gray-100);
  }
</style>
